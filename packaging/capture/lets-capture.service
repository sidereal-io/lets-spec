[Unit]
Description=Lets independent action capture runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lets-capture
Group=lets-capture
ExecStart=/opt/lets/bin/lets-capture /etc/lets/capture-service.json
ExecStopPost=/usr/bin/rm -f /run/lets-capture/capture.sock
Restart=on-failure
RestartSec=3
RuntimeDirectory=lets-capture
RuntimeDirectoryMode=0750
StateDirectory=lets-capture
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/lets-capture /var/lib/lets-capture
KillMode=control-group
TimeoutStopSec=190

[Install]
WantedBy=multi-user.target
